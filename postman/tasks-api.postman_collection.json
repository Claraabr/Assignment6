      "item": [
        {
          "name": "Create a task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const task = pm.response.json();",
                  "pm.test('task has an _id and default done=false', () => { pm.expect(task._id).to.be.a('string'); pm.expect(task.done).to.eql(false); });",
                  "pm.collectionVariables.set('taskId', task._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
